{
  "expo": {
    "name": "Spartan Coaching",
    "slug": "spartan-coaching",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/spartan-logo.png",
    "scheme": "spartan",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/spartan-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spartanhospice-coaching.appname",
      "splash": {
        "image": "./assets/images/spartan-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#0a0a0a"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSUserNotificationUsageDescription": "Spartan Coaching uses notifications to send you a daily drill reminder so you can keep your streak.",
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/spartan-logo.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.thordadpool.spartancoaching"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/spartan-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/spartan-logo.png",
          "color": "#ef4444"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "bafdaa6f-80f5-4fb0-baef-324fa376c44c"
      }
    }
  }
}
