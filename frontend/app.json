{
  "expo": {
    "name": "Spartan Coaching",
    "slug": "spartan-coaching",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/spartan-logo.png",
    "scheme": "spartan",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/spartan-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spartancoaching.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"],
        "NSUserNotificationUsageDescription": "Spartan Coaching uses notifications to send you a daily drill reminder so you can keep your streak."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/spartan-logo.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.spartancoaching.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/spartan-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/spartan-logo.png",
          "color": "#ef4444"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
