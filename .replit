modules = ["nodejs-20", "web", "python-3.11"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["python_database:1.0.0", "python_openai_ai_integrations:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["eas-cli"]

[userenv]

[userenv.shared]
DB_NAME = "spartan_coaching"
LLM_MODEL = "gpt-4o"
LLM_MODEL_FAST = "gpt-4o-mini"
CONTACT_EMAIL = "nick@spartanhospicecoaching.com"
RESEND_FROM_NAME = "Spartan Coaching"
ADMIN_TOKEN = "5413"
PORT = "8000"
EXPO_PUBLIC_BACKEND_URL = "https://api.spartanhospicecoaching.com"
STRIPE_PRO_PRICE_ID = "price_1TgVsULsjQz1kEqVOArnb59R"
STRIPE_TEAM_5_PRICE_ID = "price_1TgWLOLF4JQdUFsUXy3XB8mu"
STRIPE_TEAM_10_PRICE_ID = "price_1TgWLPLF4JQdUFsUG1WkALt7"
EXPO_PUBLIC_BETA_UNLOCK = "1"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && uvicorn server:app --host 0.0.0.0 --port 8000 --reload"
waitForPort = 8000

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node proxy.js & cd frontend && npm start"
waitForPort = 5000

[[ports]]
localPort = 3000
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd backend && pip install -r requirements.txt --extra-index-url https://d33sy5i8bnduwe.cloudfront.net/simple/ -q && uvicorn server:app --host 0.0.0.0 --port 5000"]
build = ["bash", "-c", "cd backend && pip install -r requirements.txt --extra-index-url https://d33sy5i8bnduwe.cloudfront.net/simple/ -q"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
